option_settings:
  aws:elasticbeanstalk:container:nodejs:
	NodeCommand: "npm start"
  aws:elasticbeanstalk:application:environment:
	NODE_ENV: "production"
  aws:autoscaling:asg:
	MinSize: 1
	MaxSize: 3
  aws:autoscaling:trigger:
	MeasureName: CPUUtilization
	Statistic: Average
	Unit: Percent
	UpperThreshold: 80
	LowerThreshold: 20

commands:
  01_install_curl:
	command: "yum install -y curl"
  02_create_log_dir:
	command: "mkdir -p /var/log/bdt-arena"

container_commands:
  01_migrate_database:
	command: "npm run migrate"
	leader_only: true
  02_seed_database:
	command: "npm run seed"
	leader_only: true

files:
  "/etc/cloudwatch/config.json":
	mode: "000644"
	owner: root
	group: root
	content: |
	  {
		"agent": {
		  "credentials": {
			"useinstancerole": true
		  }
		},
		"logs": {
		  "logs_collected": {
			"files": {
			  "collect_list": [
				{
				  "file_path": "/var/log/bdt-arena/combined.log",
				  "log_group_name": "/aws/elasticbeanstalk/bdt-arena/application",
				  "log_stream_name": "{instance_id}"
				}
			  ]
			}
		  }
		}
	  }

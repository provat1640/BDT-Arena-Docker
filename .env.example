# Sandbox defaults: never enable real rails until explicitly reviewed
PAYMENT_MODE=sandbox
MARKET_MODE=simulated
NODE_ENV=development
TZ=Asia/Dhaka

POSTGRES_DB=bdt_arena
POSTGRES_USER=bdt_arena
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://bdt_arena:change-me-local-only@db:5432/bdt_arena

JWT_ACCESS_SECRET=change-this-access-secret-local-only
JWT_REFRESH_SECRET=change-this-refresh-secret-local-only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:3000

FRONTEND_PORT=3000
BACKEND_PORT=4000
PUBLIC_BACKEND_URL=http://localhost:4000
ANDROID_BACKEND_URL=http://localhost:4000
ANDROID_APK_URL=/downloads/bdt-arena.apk
ANDROID_STORE_URL=https://play.google.com/store/apps

# Optional real payment credentials; ignored while PAYMENT_MODE=sandbox
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX_BASE_URL=https://sandbox.bka.sh
NAGAD_APP_ID=
NAGAD_APP_SECRET=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_SANDBOX_BASE_URL=https://sandbox.nagad.com.bd
